<?xml version='1.0'?>

<launch>
  <arg name="robot_name" default="racebot"/>

  <group ns="$(arg robot_name)">

    <!-- 加载控制器配置到各车命名空间 -->
    <rosparam file="$(find racebot_control)/config/racebot_control.yaml" command="load"
              subst_value="true"/>

    <!-- 启动控制器 -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner"
          respawn="false" output="screen"
          args="--namespace=/$(arg robot_name)
                left_rear_wheel_velocity_controller right_rear_wheel_velocity_controller
                left_front_wheel_velocity_controller right_front_wheel_velocity_controller
                left_steering_hinge_position_controller right_steering_hinge_position_controller
                joint_state_controller"/>

    <!-- robot_state_publisher 在命名空间内，joint_states 话题自动匹配 -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
      <!-- robot_description is loaded at /$(robot_name)/robot_description by racebot.launch -->
      <param name="robot_description" value="/$(arg robot_name)/robot_description"/>
      <param name="tf_prefix" value="$(arg robot_name)"/>
    </node>

    <!-- servo 控制节点 -->
    <node pkg="racebot_control" type="servo_commands.py" name="servo_commands" output="screen">
      <param name="robot_name" value="$(arg robot_name)"/>
    </node>

    <!-- ackermann -> twist 转换节点 -->
    <node pkg="racebot_control" type="transform.py" name="transform" output="screen"/>

    <!-- 里程计节点 -->
    <node pkg="racebot_control" name="gazebo_odometry_node" type="gazebo_odometry.py">
      <param name="robot_name" value="$(arg robot_name)"/>
    </node>

  </group>

</launch>
