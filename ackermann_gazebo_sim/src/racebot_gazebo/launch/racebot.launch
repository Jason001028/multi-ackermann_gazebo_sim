<?xml version="1.0"?>
<launch>
    <arg name="robot_name" default="racebot"/>
    <arg name="paused" default="false"/>
    <arg name="use_sim_time" default="true"/>
    <arg name="gui" default="true"/>
    <arg name="headless" default="false"/>
    <arg name="debug" default="false"/>
    <arg name="x_pos" default="0"/>
    <arg name="y_pos" default="0"/>
    <arg name="z_pos" default="0"/>
    <arg name="R_pos" default="0"/>
    <arg name="P_pos" default="0"/>
    <arg name="Y_pos" default="0"/>

    <!-- 运行gazebo仿真环境（仅第一辆车启动，其余车共用同一个world） -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch" if="$(eval robot_name == 'racebot' or robot_name == 'car1')">
        <arg name="debug" value="$(arg debug)" />
        <arg name="gui" value="$(arg gui)" />
        <arg name="paused" value="$(arg paused)"/>
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
        <arg name="headless" value="$(arg headless)"/>
        <arg name="world_name" value="$(find racebot_gazebo)/worlds/tiny.world"/>
    </include>

    <!-- 加载机器人模型描述参数到各自命名空间 -->
    <param name="$(arg robot_name)/robot_description"
           command="$(find xacro)/xacro --inorder '$(find racebot_description)/urdf/ackermann/racecar.xacro' robot_name:=$(arg robot_name)"/>

    <!-- 在gazebo中加载机器人模型 -->
    <node name="urdf_spawner_$(arg robot_name)" pkg="gazebo_ros" type="spawn_model"
          respawn="false" output="screen"
          args="-urdf -model $(arg robot_name) -param $(arg robot_name)/robot_description
                -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos)
                -R $(arg R_pos) -P $(arg P_pos) -Y $(arg Y_pos)"/>

    <!-- ros_control 控制器（在各车命名空间下启动） -->
    <include file="$(find racebot_control)/launch/racebot_control.launch">
        <arg name="robot_name" value="$(arg robot_name)"/>
    </include>

    <rosparam command="load" file="$(find racebot_gazebo)/config/keyboard_teleop.yaml"
              ns="$(arg robot_name)"/>
    <node pkg="racebot_gazebo" type="keyboard_teleop.py" name="keyboard_teleop_$(arg robot_name)"
          ns="$(arg robot_name)"/>

</launch>
